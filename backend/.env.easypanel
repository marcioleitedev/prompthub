APP_NAME="PromptHub API"
APP_ENV=production
APP_KEY=base64:GERAR_COM_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://api-prompthub.marcioleite.cloud
FRONTEND_URL=https://marcioleite.cloud

APP_LOCALE=pt-BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Configurações do Banco de Dados
DB_CONNECTION=mysql
DB_HOST=SEU_HOST_MYSQL_EASYPANEL
DB_PORT=3306
DB_DATABASE=prompthub
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=SUA_SENHA

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.marcioleite.cloud

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=prompthub_

# Configurações Redis
REDIS_CLIENT=phpredis
REDIS_HOST=SEU_HOST_REDIS_EASYPANEL
REDIS_PASSWORD=SUA_SENHA_REDIS
REDIS_PORT=6379

# Configurações de Email (se necessário)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_app
MAIL_FROM_ADDRESS="noreply@marcioleite.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=SEU_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# JWT Settings
JWT_SECRET=GERAR_COM_php_artisan_jwt:secret
JWT_TTL=60

# Reverb WebSocket
REVERB_APP_ID=prompthub
REVERB_APP_KEY=sua_key_aqui
REVERB_APP_SECRET=seu_secret_aqui
REVERB_HOST=wss://api-prompthub.marcioleite.cloud
REVERB_PORT=8080
REVERB_SCHEME=https

# Swagger/L5-Swagger
L5_SWAGGER_USE_ABSOLUTE_PATH=true
L5_FORMAT_TO_USE_FOR_DOCS=json

# Migrations automáticas no deploy
DB_AUTO_MIGRATE=false
